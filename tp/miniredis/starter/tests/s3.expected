# Les séances précédentes doivent toujours fonctionner
SET k v
=> OK
RPUSH l a b
=> (integer) 2
LRANGE l 0 -1
=> ["a", "b"]
GET l
=> (error) WRONGTYPE Operation against a key holding the wrong kind of value

# 🟢 KEYS et MGET avec les streams
FLUSHALL
=> OK
SET user:1 a
=> OK
SET user:2 b
=> OK
RPUSH user:liste x
=> (integer) 1
SET admin x
=> OK
KEYS user:*
=> ["user:1", "user:2", "user:liste"]
KEYS *
=> ["admin", "user:1", "user:2", "user:liste"]
KEYS absent*
=> []
MGET user:1 absente user:liste user:2
=> ["a", (nil), (nil), "b"]

# 🟢 SET NX et XX
SET verrou a NX
=> OK
SET verrou b NX
=> (nil)
GET verrou
=> "a"
SET verrou c XX
=> OK
GET verrou
=> "c"
SET autre c XX
=> (nil)
GET autre
=> (nil)
SET verrou d NX XX
=> (error) ERR syntax error
SET verrou e EX 100 NX
=> (nil)
SET nouveau e NX EX 100
=> OK
TTL nouveau
=> (integer) 100
SETNX verrou f
=> (integer) 0
SETNX libre f
=> (integer) 1
GET libre
=> "f"
SETNX verrou
=> (error) ERR wrong number of arguments for 'setnx' command

# 🟢 Persistance : SAVE répond OK (le rechargement se teste en relançant le serveur)
SAVE
=> OK
SAVE extra
=> (error) ERR wrong number of arguments for 'save' command

# 🔵 DBSIZE
FLUSHALL
=> OK
DBSIZE
=> (integer) 0
SET user:1 a
=> OK
RPUSH user:liste x
=> (integer) 1
DBSIZE
=> (integer) 2
DBSIZE extra
=> (error) ERR wrong number of arguments for 'dbsize' command
