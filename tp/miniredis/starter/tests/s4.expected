# Les séances précédentes doivent toujours fonctionner
INCR compteur
=> (integer) 1
RPUSH l a
=> (integer) 1
LRANGE l 0 -1
=> ["a"]
SET verrou a NX
=> OK
SET verrou b NX
=> (nil)
GET verrou
=> "a"
SAVE
=> OK

# 🟣 AUTH sans mot de passe configuré
AUTH default nimportequoi
=> OK
AUTH secret
=> (error) ERR AUTH <password> called without any password configured for the default user. Are you sure your configuration is correct?
AUTH
=> (error) ERR wrong number of arguments for 'auth' command
AUTH a b c
=> (error) ERR syntax error
